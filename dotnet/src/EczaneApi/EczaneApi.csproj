<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <PackageId>EczaneApi</PackageId>
    <Version>1.0.0</Version>
    <Authors>BetaSoft Yazılım</Authors>
    <Company>BetaSoft Yazılım</Company>
    <Product>EczaneApi</Product>
    <Description>Türkiye 81 İl ve 973 İlçesi İçin Resmi ve Güncel Nöbetçi Eczane API .NET / C# İstemcisi</Description>
    <PackageTags>eczane;nobetci-eczane;turkiye;api;saglik;pharmacy;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/betasoftyazilim/eczaneapi</RepositoryUrl>
    <PackageProjectUrl>https://betasoft.com.tr</PackageProjectUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
