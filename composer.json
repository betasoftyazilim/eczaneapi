{
    "name": "betasoftyazilim/eczaneapi",
    "description": "Türkiye 81 İl ve İlçeleri İçin Nöbetçi Eczane API ve Kazıma Motoru (Laravel ve Tüm MVC Mimarileriyle Tam Uyumlu)",
    "version": "1.0.1",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "BetaSoft Yazılım",
            "email": "betasoftyazilim@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.0",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "maxmind-db/reader": "^1.11"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "EczaneApi\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "EczaneApi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "EczaneApi\\Laravel\\EczaneServiceProvider"
            ],
            "aliases": {
                "Eczane": "EczaneApi\\Laravel\\Facades\\Eczane"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
